# LƯU Ý: Cloudflare CỘNG DỒN mọi quy tắc khớp, không ưu tiên cái cụ thể hơn.
# Vì vậy KHÔNG được dùng /* ở đây — nó sẽ chèn no-cache vào cả /assets/*.
# Các đường dẫn dưới đây được liệt kê rõ để không chồng lấn nhau.

# Trang HTML: luôn kiểm tra lại với server (304 rất nhẹ)
/
  Cache-Control: public, no-cache
/*.html
  Cache-Control: public, no-cache
/dich-vu/*
  Cache-Control: public, no-cache
/tin-tuc/*
  Cache-Control: public, no-cache
/gioi-thieu/*
  Cache-Control: public, no-cache
/cong-tac-vien/*
  Cache-Control: public, no-cache
/lien-he/*
  Cache-Control: public, no-cache
/js/*
  Cache-Control: public, no-cache
/styles/*
  Cache-Control: public, no-cache

# Trang quản trị: KHÔNG khai Disallow trong robots.txt (tự lộ đường dẫn — xem
# static-site-build.md mục 6b), chặn bot bằng header này thay vào đó (mạnh hơn thẻ
# <meta> vì không phụ thuộc bot có parse HTML hay không, phủ luôn mọi file con).
/admin/*
  Cache-Control: public, no-cache
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
/admin-gas/*
  Cache-Control: public, no-cache
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex

# Ảnh/font: cache 1 năm.
# Khi thay ảnh phải ĐỔI TÊN FILE, nếu không trình duyệt cũ vẫn dùng bản cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# TinyMCE tự host (dùng bởi gas/js.html khi nhúng /admin/ - CDN bị chặn trong iframe sandbox
# của script.google.com, xem GAS.md mục II.1). Cache dài vì bản đóng gói cố định theo thư mục,
# nâng cấp version thì thay cả thư mục html/vendor/tinymce/, không ghi đè lẻ từng file.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
